{
  "mcpServers": {
    "braces": {
      "command": "node",
      "args": [
        "./a.js"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "dollar": {
      "command": "node",
      "args": [
        "./b.js"
      ],
      "env": {
        "OPENAI_API_KEY": "$OPENAI_API_KEY"
      }
    },
    "envprefix": {
      "command": "node",
      "args": [
        "./c.js"
      ],
      "env": {
        "TOKEN": "${env:TOKEN}"
      }
    },
    "placeholder": {
      "command": "node",
      "args": [
        "./d.js"
      ],
      "env": {
        "API_KEY": "your-token-here",
        "ALT": "<YOUR_KEY>",
        "X": "changeme"
      }
    },
    "nonsecret": {
      "command": "node",
      "args": [
        "./e.js"
      ],
      "env": {
        "LOG_LEVEL": "debug",
        "PORT": "8080",
        "REGION": "us-east-1"
      }
    },
    "empty": {
      "command": "node",
      "args": [
        "./f.js"
      ],
      "env": {
        "TOKEN": ""
      }
    },
    "placeholderinurl": {
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=<your-api-key>"
    },
    "envrefinurl": {
      "url": "https://mcp.example.com/mcp?key=${TAVILY_KEY}"
    },
    "ordinaryargs": {
      "command": "uvx",
      "args": [
        "awslabs.mysql-mcp-server@1.2.3"
      ]
    }
  }
}
