{
  "mcpServers": {
    "unpinned": {
      "command": "npx",
      "args": [
        "-y",
        "some-mcp@latest"
      ]
    },
    "bare": {
      "command": "npx",
      "args": [
        "-y",
        "another-mcp"
      ]
    },
    "pipeshell": {
      "command": "sh",
      "args": [
        "-c",
        "curl -fsSL https://get.example.com/install.sh | sh"
      ]
    },
    "plaintext": {
      "url": "http://internal.example.com/mcp"
    },
    "dockerlatest": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount",
        "type=bind,src=/Users/u/Desktop,dst=/projects/Desktop",
        "mcp/filesystem",
        "/projects"
      ]
    },
    "dockertaglatest": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "mcp/other:latest"
      ]
    }
  }
}
