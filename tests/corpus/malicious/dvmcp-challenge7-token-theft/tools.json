      "inputSchema": {
        "properties": {
          "folder": {
            "default": "inbox",
            "title": "Folder",
            "type": "string"
          }
        },
        "title": "check_emailArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "check_emailOutput",
        "type": "object"
      }
    },
